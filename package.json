{
  "name": "@nquandt/pi-azure-foundry",
  "version": "1.0.3",
  "description": "Pi extension for Azure AI Foundry — discovers deployments and registers models",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nquandt/pi-azure-foundry.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "azure",
    "foundry",
    "ai",
    "provider"
  ],
  "author": "Nicholas Quandt",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bundledDependencies": [
    "@azure/identity"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node test/converters.test.mjs && node test/extension.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^20.19.43",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@earendil-works/pi-ai": "^0.84.4"
  },
  "bundleDependencies": [
    "@azure/identity"
  ]
}
